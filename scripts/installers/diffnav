#!/bin/bash
# set -x
set -e

APP=diffnav

DIR=$(cd -- "$(dirname -- "$0")" && pwd)
source "$DIR/helpers"

# has_binary, not command -v: this script shares its name with the binary it
# installs, so a plain lookup can find the script itself and skip the install.
if has_binary $APP; then
    exit 0
fi

if has_binary brew; then
    brew install $APP
    exit 0
fi

# Assets are named diffnav_Linux_x86_64 / diffnav_Linux_arm64 -- goreleaser
# keeps x86_64 but renames aarch64 to arm64, so `uname -m` alone is not enough.
SUFFIX="_$(uname -s)_$(arch_for mixed).tar.gz"
URL=$(github_asset_url dlvhdr/$APP "$SUFFIX")

if [ -z "$URL" ]; then
    echo "No $APP release asset matching *$SUFFIX"
    exit 1
fi

download_to ~/Downloads/$APP.tar.gz "$URL"
tar -xzf ~/Downloads/$APP.tar.gz -C ~/Downloads
chmod +x ~/Downloads/$APP
mkdir -p ~/.local/bin
mv -f ~/Downloads/$APP ~/.local/bin/$APP
rm -f ~/Downloads/$APP.tar.gz
