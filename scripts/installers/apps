#!/bin/bash
# set -x
set -e

DIR=$(dirname -- "$(readlink -f -- "$0")")


if [ "$CODESPACES" = true ]; then
    echo "Running in codespaces...skipping unnecessary tool installs"
    exit 0;
fi

"$DIR/app/1password"
"$DIR/app/github"
"$DIR/app/vscode"
"$DIR/app/ghostty"
"$DIR/app/wezterm"

# app-image-launcher is deliberately not run here; it is a manual, interactive
# script. Run it yourself:  ~/.dotfiles/scripts/installers/app/app-image-launcher