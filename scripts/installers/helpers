#!/bin/bash
set -e
# set -x

INSTALLERS_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

# Maps a binary name to its package name, only when the two differ.
BINARY_PKG_ALIASES=(
    "rg ripgrep"
    "nvim neovim"
    "delta git-delta"
)

# Per-package-manager overrides, also keyed by binary name.
DNF_BINARY_PKG_ALIASES=(
    "fd fd-find"
)

function map_get() {
    local key="$1"
    shift
    local -a map=("$@")

    for entry in "${map[@]}"; do
        IFS=' ' read -r map_key map_value <<< "$entry"
        if [ "$key" = "$map_key" ]; then
            echo "$map_value"
            return 0
        fi
    done

    echo "$key"
    return 0
}

# Looks for a binary, ignoring "." and the installers dir on PATH.
# Without this, a local installer script shadows the binary it installs.
function has_binary() {
    local entry
    local clean_path=''
    local -a parts

    IFS=':' read -r -a parts <<< "$PATH"
    for entry in "${parts[@]}"; do
        case "$entry" in
            ''|'.'|"$INSTALLERS_DIR") continue ;;
        esac
        clean_path="${clean_path:+$clean_path:}$entry"
    done

    PATH="$clean_path" command -v "$1" &>/dev/null
}

function install_my_tool() {
    for bin in "$@"; do

        if has_binary "$bin"; then
            # echo "$bin is already installed, skipping..."
            continue
        else
            echo "Installing $bin..."
        fi

        # A local installer script wins over the package manager.
        if [ -f "$INSTALLERS_DIR/$bin" ]; then
            bash "$INSTALLERS_DIR/$bin"
            continue
        fi

        pkg=$(map_get "$bin" "${BINARY_PKG_ALIASES[@]}")

        COMMAND=''
        if command -v brew &>/dev/null; then
            COMMAND="brew"
        elif command -v dnf &>/dev/null; then
            COMMAND="sudo dnf -y"
            pkg=$(map_get "$bin" "${DNF_BINARY_PKG_ALIASES[@]}")
        elif command -v apt-get &>/dev/null; then
            COMMAND="sudo apt-get -y"
        fi

        if [ -z "$COMMAND" ]; then
            echo "No package manager found"
            exit 1
        fi

        $COMMAND install $pkg
    done
}

get_distro_id() {
    if [[ -f /etc/os-release ]]; then
        # Use awk to safely extract the ID without sourcing in a function
        awk -F= '/^ID=/{print tolower($2)}' /etc/os-release
    else
        # Fallback for non-Linux systems or very old distributions
        uname | awk '{print tolower($0)}'
    fi
}

function is_git_clean() {
    # Check if inside a git repository
    # git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 128
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0 # if not a git repo, consider it clean

    # Capture the output and check the exit status
    output=$(git status --porcelain 2>/dev/null);
    
    if [ -z "$output" ]; then
        return 0 # Clean
    else
        return 1 # Dirty
    fi
}