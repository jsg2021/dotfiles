#!/bin/bash
# set -x
set -e

API="https://api.github.com/repos/so-fancy/diff-so-fancy/releases/latest"

DIR=$(cd -- "$(dirname -- "$0")" && pwd)
source "$DIR/helpers"

# has_binary, not command -v: this script shares its name with the binary it
# installs, so a plain lookup can find the script itself and skip the install.
if ! has_binary diff-so-fancy; then
    mkdir -p ~/Downloads
    curl -sL -H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28" $API \
        | jq -r '.assets[] | select(.name | contains("diff-so-fancy")) | .browser_download_url' \
        | xargs curl -fsSL -o ~/Downloads/diff-so-fancy

    chmod +x ~/Downloads/diff-so-fancy
    mkdir -p ~/.local/bin
    mv ~/Downloads/diff-so-fancy ~/.local/bin/diff-so-fancy
# else 
    # echo "diff-so-fancy is already installed, to update remove it first and run this script again"
fi
