#!/bin/bash
# set -x
set -e

APP=diff-so-fancy

DIR=$(cd -- "$(dirname -- "$0")" && pwd)
source "$DIR/helpers"

# has_binary, not command -v: this script shares its name with the binary it
# installs, so a plain lookup can find the script itself and skip the install.
if has_binary $APP; then
    exit 0
fi

# A perl script, so there is nothing arch-specific to choose.
URL=$(github_asset_url so-fancy/$APP "$APP")

if [ -z "$URL" ]; then
    echo "No $APP release asset found"
    exit 1
fi

download_to ~/Downloads/$APP "$URL"
chmod +x ~/Downloads/$APP
mkdir -p ~/.local/bin
mv -f ~/Downloads/$APP ~/.local/bin/$APP
